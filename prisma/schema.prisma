datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Multi-Tenancy
model Tenant {
  id               String            @id @default(uuid())
  code             String            @unique
  name             String
  subdomain        String?           @unique
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  users            User[]
  roles            Role[]
  devices          Device[]
  approvalRequests ApprovalRequest[]
  auditLogs        AuditLog[]
}

// 2. Granular RBAC Tables
model Role {
  id              String           @id @default(uuid())
  tenantId        String?
  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code            String           @unique
  name            String
  description     String?
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@index([code])
}

model Permission {
  id              String           @id @default(uuid())
  code            String           @unique // e.g. "device.grade.override", "inventory.adjust"
  module          String           // e.g. "Device Passport", "Inventory", "QA"
  action          String           // e.g. "override", "adjust", "create"
  description     String?

  rolePermissions RolePermission[]

  @@index([code])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([userId, roleId])
}

model UserScope {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopeType   String   // GLOBAL, TENANT, REGION, WAREHOUSE, DEPARTMENT, TEAM, ASSIGNED, OWN
  scopeValue  String   // e.g. "AUS-HUB-04" or "dept-repair" or "all"
  createdAt   DateTime @default(now())

  @@index([userId, scopeType])
}

// 3. User & Authentication
model User {
  id                 String              @id @default(uuid())
  tenantId           String
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email              String              @unique
  passwordHash       String
  fullName           String
  badgeId            String?             @unique
  facilityId         String              @default("AUS-HUB-04")
  refreshTokenHash   String?
  resetTokenHash     String?
  resetTokenExpiry   DateTime?
  isActive           Boolean             @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  userRoles          UserRole[]
  userScopes         UserScope[]
  repairs            RepairTicket[]
  inspections        QualityInspection[]
  madeApprovals      ApprovalRequest[]   @relation("MakerRelation")
  reviewedApprovals  ApprovalRequest[]   @relation("ApproverRelation")
  auditLogs          AuditLog[]

  @@index([email])
  @@index([tenantId])
}

// 4. Approval Engine
model ApprovalRequest {
  id               String            @id @default(uuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionType  String            // STOCK_ADJUSTMENT, GRADE_OVERRIDE, IMEI_CORRECTION, etc.
  title            String
  entityType       String            // DEVICE, INVENTORY, ORDER, INVOICE, etc.
  entityId         String
  makerId          String
  maker            User              @relation("MakerRelation", fields: [makerId], references: [id])
  makerRole        String
  approverRoleId   String
  approverId       String?
  approver         User?             @relation("ApproverRelation", fields: [approverId], references: [id])
  status           String            @default("PENDING") // PENDING, APPROVED, REJECTED
  urgency          String            @default("ROUTINE") // ROUTINE, HIGH, CRITICAL
  oldValue         String?
  newValue         String?
  justification    String
  reviewComment    String?
  createdAt        DateTime          @default(now())
  reviewedAt       DateTime?
  metadataJson     Json?

  steps            ApprovalStep[]
  auditLogs        AuditLog[]

  @@index([status])
  @@index([transactionType])
}

model ApprovalStep {
  id                 String          @id @default(uuid())
  approvalRequestId  String
  approvalRequest    ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  stepNumber         Int             @default(1)
  assignedRole       String
  actionTaken        String?         // APPROVED, REJECTED, PENDING
  comment            String?
  executedAt         DateTime?
}

// 5. Immutable Audit Engine
model AuditLog {
  id                String           @id @default(uuid())
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId           String?
  actor             User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName         String
  actorRole         String
  facilityId        String           @default("AUS-HUB-04")
  action            String           // e.g. "DEVICE_GRADE_OVERRIDE", "IMEI_CORRECTION"
  entity            String           // e.g. "DEVICE", "INVENTORY", "INVOICE"
  entityId          String
  oldValue          Json?
  newValue          Json?
  reason            String?
  approvalId        String?
  approvalRequest   ApprovalRequest? @relation(fields: [approvalId], references: [id], onDelete: SetNull)
  ipAddress         String
  userAgent         String?
  tamperSealHash    String           // SHA-256 HMAC of log entry
  timestamp         DateTime         @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([action])
  @@index([timestamp])
}

// 6. Device Master & Controlled Statuses
enum DeviceStatus {
  PURCHASED
  RECEIVED
  REPAIR_REQUIRED
  READY_TO_SELL
  RESERVED
  SOLD
  RETURNED
  SCRAPPED
}

model Brand {
  id        String        @id @default(uuid())
  name      String        @unique
  code      String        @unique // e.g. "APL", "SAM", "GOOG"
  logoUrl   String?
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  models    DeviceModel[]
  devices   Device[]
}

model DeviceModel {
  id          String          @id @default(uuid())
  brandId     String
  brand       Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name        String          // e.g. "iPhone 15 Pro", "Galaxy S24 Ultra"
  category    String          // SMARTPHONE, LAPTOP, TABLET
  releaseYear Int?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  variants    DeviceVariant[]
  devices     Device[]

  @@unique([brandId, name])
}

model DeviceVariant {
  id        String      @id @default(uuid())
  modelId   String
  model     DeviceModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  name      String      // e.g. "256GB / 8GB RAM / Natural Titanium"
  storage   String      // e.g. "256GB"
  ram       String      // e.g. "8GB"
  color     String      // e.g. "Natural Titanium"
  sku       String      @unique
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  devices   Device[]
}

model Device {
  id                 String              @id @default(uuid())
  organizationId     String              @default("org-truerefurb-main")
  tenantId           String
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Hardware Identifiers (UUID is PK, IMEI is unique & searchable)
  imei1              String              @unique // Validated 15-digit IMEI
  imei2              String?             // Optional validated 15-digit dual IMEI
  serialNumber       String              @unique

  // Brand / Model / Variant Hierarchy
  brand              String
  brandId            String?
  brandRef           Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  model              String
  modelId            String?
  modelRef           DeviceModel?        @relation(fields: [modelId], references: [id], onDelete: SetNull)
  variant            String?
  variantId          String?
  variantRef         DeviceVariant?      @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // Physical Specifications
  storage            String              // 128GB, 256GB, 512GB, 1TB
  ram                String              @default("8GB") // 8GB, 12GB, 16GB
  color              String
  condition          String              @default("Original OEM")
  grade              String              @default("GRADE_B") // Grade A+, A, B, C, D, Parts
  batteryHealth      Int                 @default(100)       // 0 - 100 percentage

  // Financial Cost Engine
  purchaseCost       Decimal             @db.Decimal(10, 2)
  repairCost         Decimal             @default(0) @db.Decimal(10, 2)
  otherCost          Decimal             @default(0) @db.Decimal(10, 2)
  totalCost          Decimal             @db.Decimal(10, 2) // Derived: purchase + repair + other
  sellingPrice       Decimal             @db.Decimal(10, 2)

  // Controlled Status & Logistics
  status             DeviceStatus        @default(PURCHASED)
  currentLocation    String              @default("Kolkata Main Warehouse - A01")
  warehouseId        String?
  warehouse          Warehouse?          @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  locationId         String?
  location           InventoryLocation?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  vendorId           String?
  vendor             Vendor?             @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  purchaseOrderId    String?
  purchaseOrder      PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  purchaseItem       PurchaseItem?
  notes              String?

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  // Legacy field aliases for backwards compatibility
  stage              String              @default("INTAKE")
  acquisitionCost    Decimal             @default(0) @db.Decimal(10, 2)
  targetResalePrice  Decimal             @default(0) @db.Decimal(10, 2)
  functionalScore    Int                 @default(0)
  make               String              @default("Apple")
  category           String              @default("SMARTPHONE")
  sourceLot          String?
  warehouseBay       String?
  binNumber          String?
  conditionGrade     String              @default("GRADE_B")
  imei               String?

  passport           DevicePassport?
  intake             DeviceIntake?
  diagnosticReport   DiagnosticReport?
  repairs            RepairTicket[]
  qualityInspection  QualityInspection?
  inventoryItem      InventoryItem?
  trueScores         TrueScoreRecord[]
  salesOrderItems    SalesOrderItem[]
  invoiceItemDevices InvoiceItemDevice[]

  @@index([status])
  @@index([brand])
  @@index([model])
  @@index([grade])
  @@index([currentLocation])
  @@index([imei1])
  @@index([imei2])
  @@index([warehouseId])
  @@index([locationId])
  @@index([vendorId])
}

model DevicePassport {
  id                 String              @id @default(uuid())
  deviceId           String              @unique
  device             Device              @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  lifecycleStage     String              @default("RECEIVED")
  trueScore          Int                 @default(85)
  warrantyStatus     String              @default("ACTIVE")
  custodyHistoryJson Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model TrueScoreRecord {
  id                   String            @id @default(uuid())
  deviceId             String
  device               Device            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  overallScore         Int               // 0 - 100
  diagnosticScore      Int
  cosmeticGradeScore   Int
  batteryHealthScore   Int
  repairIntegrityScore Int
  partsScore           Int
  lifecycleAgeScore    Int
  finalizedBy          String
  isLocked             Boolean           @default(false)
  calculatedAt         DateTime          @default(now())

  @@index([deviceId])
}

model DeviceIntake {
  id              String        @id @default(uuid())
  deviceId        String        @unique
  device          Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  receivedAt      DateTime      @default(now())
  carrierSource   String
  initialNotes    String?
  dockStationId   String
}

model DiagnosticReport {
  id                   String                 @id @default(uuid())
  deviceId             String                 @unique
  device               Device                 @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  batteryCycleCount    Int                    @default(0)
  batteryHealthPercent Int                    @default(100)
  screenCondition      String                 @default("FLAWLESS")
  allPassed            Boolean                @default(false)
  completedAt          DateTime               @default(now())
  checklist            DiagnosticCheckItem[]
}

model DiagnosticCheckItem {
  id          String            @id @default(uuid())
  reportId    String
  report      DiagnosticReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  name        String
  category    String
  status      String            @default("UNTESTED")
  score       Int               @default(100)
  measuredVal String?
}

model RepairTicket {
  id              String        @id @default(uuid())
  deviceId        String
  device          Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  technicianId    String
  technician      User          @relation(fields: [technicianId], references: [id])
  issueSummary    String
  resolution      String
  partsCost       Decimal       @default(0) @db.Decimal(10, 2)
  laborMinutes    Int           @default(0)
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
}

model QualityInspection {
  id              String         @id @default(uuid())
  deviceId        String         @unique
  device          Device         @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  inspectorId     String
  inspector       User           @relation(fields: [inspectorId], references: [id])
  visualGrade     String
  functionalScore Int
  approved        Boolean        @default(false)
  tamperSealHash  String?
  inspectedAt     DateTime       @default(now())
}

model InventoryItem {
  id               String        @id @default(uuid())
  deviceId         String        @unique
  device           Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  sku              String        @unique
  listedPrice      Decimal       @db.Decimal(10, 2)
  amazonListed     Boolean       @default(false)
  backMarketListed Boolean       @default(false)
  ebayListed       Boolean       @default(false)
  b2bListed        Boolean       @default(true)
  stockBay         String
  shelfNumber      String
  updatedAt        DateTime      @updatedAt
}

// =========================================================================
// Multi-Warehouse & Inventory Location Architecture
// =========================================================================
model Warehouse {
  id             String              @id @default(uuid())
  code           String              @unique // e.g. "WH-KOL-01"
  name           String              // e.g. "Kolkata Main Warehouse"
  address        String
  city           String
  state          String
  postalCode     String
  country        String              @default("India")
  phone          String?
  email          String?
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  locations      InventoryLocation[]
  devices        Device[]
  purchaseOrders PurchaseOrder[]
}

model InventoryLocation {
  id          String      @id @default(uuid())
  warehouseId String
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  code        String      // e.g. "A01", "A02", "B01", "B02"
  zone        String      // e.g. "Zone A", "Intake Dock"
  aisle       String?
  shelf       String?
  bin         String?
  description String?
  capacity    Int         @default(50)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  devices     Device[]

  @@unique([warehouseId, code])
  @@index([warehouseId])
}

// =========================================================================
// Vendor Management Models
// =========================================================================
model Vendor {
  id             String          @id @default(uuid())
  vendorName     String          // Contact Person Name
  businessName   String          // Registered Trade Entity (e.g. "ABC Mobiles")
  phone          String
  email          String
  gstin          String          // 15-character Indian GSTIN
  address        String
  city           String
  state          String
  notes          String?
  status         String          @default("ACTIVE") // ACTIVE, INACTIVE, BLOCKED
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  devices        Device[]
  purchaseOrders PurchaseOrder[]

  @@index([businessName])
  @@index([gstin])
}

// =========================================================================
// Purchase Module & Workflow Models
// =========================================================================
enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum PaymentStatus {
  PAID
  PARTIAL
  UNPAID
}

model PurchaseOrder {
  id                     String         @id @default(uuid())
  vendorId               String
  vendor                 Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  purchaseDate           DateTime       @default(now())
  referenceNumber        String         @unique // e.g. "PO-2026-0084"
  paymentStatus          PaymentStatus  @default(UNPAID)
  status                 PurchaseStatus @default(DRAFT)
  totalAmount            Decimal        @db.Decimal(10, 2)
  paidAmount             Decimal        @default(0) @db.Decimal(10, 2)
  outstandingAmount      Decimal        @db.Decimal(10, 2)
  destinationWarehouseId String?
  destinationWarehouse   Warehouse?     @relation(fields: [destinationWarehouseId], references: [id], onDelete: SetNull)
  notes                  String?
  receivedAt             DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  items                  PurchaseItem[]
  devices                Device[]

  @@index([vendorId])
  @@index([status])
  @@index([paymentStatus])
}

model PurchaseItem {
  id           String        @id @default(uuid())
  purchaseId   String
  purchase     PurchaseOrder @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  brand        String
  model        String
  variant      String?
  storage      String
  ram          String?
  color        String
  imei1        String        // Validated 15-digit Luhn IMEI
  imei2        String?
  serialNumber String?
  cost         Decimal       @db.Decimal(10, 2) // Single unit purchase cost
  grade        String        @default("GRADE_B")
  condition    String        @default("Original OEM")
  quantity     Int           @default(1)
  deviceId     String?       @unique
  device       Device?       @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  isReceived   Boolean       @default(false)
  receivedAt   DateTime?
  locationCode String?

  @@index([purchaseId])
  @@index([imei1])
}

// =========================================================================
// Customer Management & Sales Invoicing Models
// =========================================================================
model Customer {
  id           String            @id @default(uuid())
  name         String            // Contact Person Name
  businessName String            // Registered Trade Entity (e.g. "Metro Refurb Store")
  phone        String
  email        String
  gstin        String?           // GSTIN if B2B customer
  address      String
  city         String
  state        String
  notes        String?
  status       String            @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  invoices     CustomerInvoice[]
  salesOrders  SalesOrder[]
  billingInvoices Invoice[]

  @@index([businessName])
  @@index([phone])
}

model CustomerInvoice {
  id                String                @id @default(uuid())
  invoiceNumber     String                @unique // e.g. "INV-2026-0042"
  customerId        String
  customer          Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoiceDate       DateTime              @default(now())
  dueDate           DateTime
  paymentStatus     PaymentStatus         @default(UNPAID)
  subtotal          Decimal               @db.Decimal(10, 2)
  taxAmount         Decimal               @db.Decimal(10, 2)
  totalAmount       Decimal               @db.Decimal(10, 2)
  paidAmount        Decimal               @default(0) @db.Decimal(10, 2)
  outstandingAmount Decimal               @db.Decimal(10, 2)
  notes             String?
  createdAt         DateTime              @default(now())

  items             CustomerInvoiceItem[]

  @@index([customerId])
  @@index([paymentStatus])
}

model CustomerInvoiceItem {
  id             String          @id @default(uuid())
  invoiceId      String
  invoice        CustomerInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  deviceId       String?
  imei           String
  brand          String
  model          String
  storage        String
  grade          String
  sellingPrice   Decimal         @db.Decimal(10, 2)
  warrantyMonths Int             @default(6)

  @@index([invoiceId])
  @@index([imei])
}

// =========================================================================
// Modules 12-15: Sales, Billing Engine, Payments & Notes Models
// =========================================================================

enum BillingMode {
  REGULAR_GST
  MARGIN_SCHEME
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CARD
  OTHER
}

enum InvoiceStatus {
  DRAFT
  FINALIZED
  PAID
  PARTIAL
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  INVOICED
  CANCELLED
}

model SalesOrder {
  id               String            @id @default(uuid())
  orderNumber      String            @unique // e.g. "SO-2026-0045"
  customerId       String
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerName     String
  businessName     String
  orderDate        DateTime          @default(now())
  status           SalesOrderStatus  @default(DRAFT)
  totalAmount      Decimal           @db.Decimal(12, 2)
  totalCost        Decimal           @db.Decimal(12, 2)
  totalGrossProfit Decimal           @db.Decimal(12, 2) // sellingPrice - totalCost
  invoiceId        String?           @unique
  invoice          Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  items            SalesOrderItem[]

  @@index([customerId])
  @@index([status])
}

model SalesOrderItem {
  id                       String     @id @default(uuid())
  salesOrderId             String
  salesOrder               SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  deviceId                 String
  device                   Device     @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  imei                     String
  brand                    String
  model                    String
  storage                  String
  color                    String
  grade                    String
  purchaseCost             Decimal    @db.Decimal(10, 2)
  repairCost               Decimal    @default(0) @db.Decimal(10, 2)
  otherCost                Decimal    @default(0) @db.Decimal(10, 2)
  totalCost                Decimal    @db.Decimal(10, 2)
  sellingPrice             Decimal    @db.Decimal(10, 2)
  grossProfit              Decimal    @db.Decimal(10, 2) // Selling price - Total cost (strictly device-level gross profit)
  grossProfitMarginPercent Decimal    @db.Decimal(5, 2)

  @@index([salesOrderId])
  @@index([deviceId])
}

model Invoice {
  id                         String         @id @default(uuid())
  invoiceNumber              String         @unique // e.g. "TR/26-27/097"
  invoiceDate                DateTime       @default(now())
  dueDate                    DateTime
  billingMode                BillingMode    // REGULAR_GST or MARGIN_SCHEME (immutable once finalized)
  status                     InvoiceStatus  @default(DRAFT)
  isFinalized                Boolean        @default(false)
  finalizedAt                DateTime?
  finalizedBy                String?

  customerId                 String
  customer                   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Seller Snapshot
  sellerLegalName            String
  sellerBusinessName         String
  sellerAddress              String
  sellerGstin                String
  sellerState                String
  sellerStateCode            String
  sellerPhone                String
  sellerEmail                String
  sellerBankDetails          Json?

  // Buyer Snapshot
  buyerName                  String
  buyerBusinessName          String
  buyerAddress               String
  buyerGstin                 String?
  buyerState                 String
  buyerStateCode             String
  placeOfSupply              String
  isInterState               Boolean        @default(false)

  // Items & Quantities
  totalQuantity              Int            @default(1)

  // Financial Breakdown
  subtotal                   Decimal        @db.Decimal(12, 2)
  itemDiscountsTotal         Decimal        @default(0) @db.Decimal(12, 2)
  invoiceDiscount            Decimal        @default(0) @db.Decimal(12, 2)
  totalDiscount              Decimal        @default(0) @db.Decimal(12, 2)

  // GST & Margin Scheme breakdown
  taxableAmount              Decimal        @db.Decimal(12, 2)
  cgstAmount                 Decimal        @default(0) @db.Decimal(12, 2)
  sgstAmount                 Decimal        @default(0) @db.Decimal(12, 2)
  igstAmount                 Decimal        @default(0) @db.Decimal(12, 2)
  totalTax                   Decimal        @default(0) @db.Decimal(12, 2)

  // Margin Scheme Fields (demonstrated in TR/26-27/097)
  exemptedAmountMarginScheme Decimal        @default(0) @db.Decimal(12, 2)
  totalAmount                Decimal        @db.Decimal(12, 2)
  depositReceived            Decimal        @default(0) @db.Decimal(12, 2)
  netPayableTotal            Decimal        @db.Decimal(12, 2)
  balanceDue                 Decimal        @db.Decimal(12, 2)

  taxPolicyVersion           String         @default("GST-RULE-32-5-v2")
  termsConfigId              String?
  termsConfig                InvoiceTermsConfig? @relation(fields: [termsConfigId], references: [id], onDelete: SetNull)
  notes                      String?

  salesOrder                 SalesOrder?
  items                      InvoiceItem[]
  payments                   PaymentRecord[]
  creditNotes                CreditNote[]
  debitNotes                 DebitNote[]
  eInvoice                   EInvoiceRecord?
  eWayBill                   EWayBillRecord?

  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([billingMode])
  @@index([invoiceNumber])
}

model InvoiceItem {
  id           String              @id @default(uuid())
  invoiceId    String
  invoice      Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sNo          Int
  productName  String              // "iPhone 13"
  storage      String              // "128GB"
  imei         String              // Serialized IMEI
  productType  String              @default("Refurbished")
  hsnCode      String              @default("8517")
  quantity     Int                 @default(1) // Strictly 1 for serialized device
  unitPrice    Decimal             @db.Decimal(10, 2)
  discount     Decimal             @default(0) @db.Decimal(10, 2)
  taxableValue Decimal             @db.Decimal(10, 2)
  cgstRate     Decimal?            @db.Decimal(5, 2)
  cgstAmount   Decimal?            @db.Decimal(10, 2)
  sgstRate     Decimal?            @db.Decimal(5, 2)
  sgstAmount   Decimal?            @db.Decimal(10, 2)
  igstRate     Decimal?            @db.Decimal(5, 2)
  igstAmount   Decimal?            @db.Decimal(10, 2)
  totalTax     Decimal             @default(0) @db.Decimal(10, 2)
  amount       Decimal             @db.Decimal(10, 2)

  devices      InvoiceItemDevice[]

  @@index([invoiceId])
  @@index([imei])
}

model InvoiceItemDevice {
  id                       String      @id @default(uuid())
  invoiceItemId            String
  invoiceItem              InvoiceItem @relation(fields: [invoiceItemId], references: [id], onDelete: Cascade)
  deviceId                 String
  device                   Device      @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  imei                     String
  imei2                    String?
  serialNumber             String?
  brand                    String
  model                    String
  storage                  String
  color                    String?
  grade                    String?
  productType              String      @default("Refurbished")
  hsnCode                  String      @default("8517")

  purchaseCost             Decimal     @db.Decimal(10, 2)
  repairCost               Decimal     @default(0) @db.Decimal(10, 2)
  otherCost                Decimal     @default(0) @db.Decimal(10, 2)
  totalCost                Decimal     @db.Decimal(10, 2)
  sellingPrice             Decimal     @db.Decimal(10, 2)
  discount                 Decimal     @default(0) @db.Decimal(10, 2)
  netSaleValue             Decimal     @db.Decimal(10, 2)

  grossProfit              Decimal     @db.Decimal(10, 2) // netSaleValue - totalCost
  grossProfitMarginPercent Decimal     @db.Decimal(5, 2)

  marginValue              Decimal     @db.Decimal(10, 2) // netSaleValue - purchaseCost
  taxableMargin            Decimal     @db.Decimal(10, 2) // max(0, marginValue)
  taxAmount                Decimal     @db.Decimal(10, 2)
  exemptedAmount           Decimal     @db.Decimal(10, 2) // purchaseCost

  @@index([invoiceItemId])
  @@index([deviceId])
}

model PaymentRecord {
  id            String        @id @default(uuid())
  invoiceId     String
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceNumber String
  customerId    String
  customerName  String
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  status        String        @default("PAID") // PENDING, PARTIAL, PAID
  date          DateTime      @default(now())
  reference     String        // UTR / Transaction ID
  notes         String?
  recordedBy    String?
  createdAt     DateTime      @default(now())

  @@index([invoiceId])
  @@index([customerId])
}

model CreditNote {
  id            String           @id @default(uuid())
  noteNumber    String           @unique // e.g. "CN-2026-0012"
  invoiceId     String
  invoice       Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceNumber String
  customerId    String
  customerName  String
  issueDate     DateTime         @default(now())
  reason        String           // SALES_RETURN, PRICE_REDUCTION, etc.
  subtotal      Decimal          @db.Decimal(12, 2)
  taxAmount     Decimal          @db.Decimal(12, 2)
  totalAmount   Decimal          @db.Decimal(12, 2)
  status        String           @default("ISSUED") // ISSUED, APPLIED, CANCELLED
  notes         String?
  createdAt     DateTime         @default(now())

  items         CreditNoteItem[]

  @@index([invoiceId])
}

model CreditNoteItem {
  id           String     @id @default(uuid())
  creditNoteId String
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  productName  String
  reason       String
  amount       Decimal    @db.Decimal(10, 2)
  taxAmount    Decimal    @db.Decimal(10, 2)
  totalAmount  Decimal    @db.Decimal(10, 2)

  @@index([creditNoteId])
}

model DebitNote {
  id            String          @id @default(uuid())
  noteNumber    String          @unique // e.g. "DN-2026-0008"
  invoiceId     String
  invoice       Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceNumber String
  customerId    String
  customerName  String
  issueDate     DateTime        @default(now())
  reason        String          // PRICE_REVISION_UP, etc.
  subtotal      Decimal         @db.Decimal(12, 2)
  taxAmount     Decimal         @db.Decimal(12, 2)
  totalAmount   Decimal         @db.Decimal(12, 2)
  status        String          @default("ISSUED") // ISSUED, APPLIED, CANCELLED
  notes         String?
  createdAt     DateTime        @default(now())

  items         DebitNoteItem[]

  @@index([invoiceId])
}

model DebitNoteItem {
  id          String    @id @default(uuid())
  debitNoteId String
  debitNote   DebitNote @relation(fields: [debitNoteId], references: [id], onDelete: Cascade)
  productName String
  reason      String
  amount      Decimal   @db.Decimal(10, 2)
  taxAmount   Decimal   @db.Decimal(10, 2)
  totalAmount Decimal   @db.Decimal(10, 2)

  @@index([debitNoteId])
}

model EInvoiceRecord {
  id           String   @id @default(uuid())
  invoiceId    String   @unique
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  irn          String   @unique // 64-character hash
  ackNo        String
  ackDate      DateTime
  signedQrCode String   @db.Text
  status       String   @default("GENERATED")
  errorDetails String?
  createdAt    DateTime @default(now())
}

model EWayBillRecord {
  id              String   @id @default(uuid())
  invoiceId       String   @unique
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  ewayBillNo      String   @unique // 12-digit number
  validUpto       DateTime
  distanceKm      Int
  vehicleNumber   String
  transporterId   String
  transporterName String
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
}

model InvoiceTermsConfig {
  id                         String    @id @default(uuid())
  name                       String
  warrantyPeriodText         String
  warrantyVoidConditions     Json      // string array
  tamperingPolicy            String
  liquidPhysicalDamagePolicy String
  computerGeneratedNotice    String
  returnPolicy               String
  isDefault                  Boolean   @default(true)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  invoices                   Invoice[]
}


